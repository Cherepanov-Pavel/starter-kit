---
import {
	capitalize,
} from "@/shared/utils/string";

const frameworks = [
	"readme",
	"astro",
	"react",
	"vue",
	"svelte",
];
const frameworkFromPath = frameworks.find((framework) => {
	return Astro.url.pathname.includes(framework);
});
const selectedFramework = frameworkFromPath || "readme"; // значение по умолчанию
---

<script>
// Find all buttons with the `alert` class on the page.
const select = document.getElementById('framework-select');

// Handle clicks on each button.
select?.addEventListener('input', (e) => {
	if(!e?.target){
		return
	}
	const target = e.target as HTMLSelectElement
	const value = target.value || 'astro';

	window.location.href = `/${value}`;
});
</script>

<div
	class="framework-selector"
>
	<label
		for="framework-select"
	>
		Выберите фреймворк:
	</label>
	<select
		id="framework-select"
		name="framework"
		class="framework-select"
	>
		{frameworks.map((framework) => (
			<option
				value={framework}
				selected={framework === selectedFramework}
			>
				{capitalize(framework)}
			</option>
		))}
	</select>
</div>

<style>
	.framework-selector {
		position: absolute;
		top: 0;
		right: 0;

		padding: 0.5rem;

		background-color: #f9f9f9;
		border: 1px solid #dddddd;
		border-bottom-left-radius: 8px;
	}

	.framework-select {
		padding: 0.5rem;

		font-size: 1rem;

		cursor: pointer;

		border: 1px solid #cccccc;
		border-radius: 4px;
	}

	label {
		font-size: 1rem;
		font-weight: 700;
	}
</style>

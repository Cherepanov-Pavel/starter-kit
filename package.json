{
	"name": "tic-tac-toe",
	"type": "module",
	"version": "0.0.1",
	"devEngines": {
		"packageManager": {
			"name": "npm",
			"version": "11.20.0"
		},
		"runtime": {
			"name": "node",
			"version": "26.11.1"
		}
	},
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"astro": "astro",
		"lint": "run-p -lc lint:js lint:css",
		"lint:fix": "run-p -lc lint:js:fix lint:css:fix",
		"lint:js": "eslint",
		"lint:js:fix": "npm run lint:js -- --fix",
		"lint:css": "stylelint \"./**/*.{css,vue,astro}\" --ignore-path .gitignore --formatter verbose",
		"lint:css:fix": "npm run lint:css -- --fix",
		"lint:test": "eslint ./frontend-configs.env.json5 --fix"
	},
	"allowScripts": {
		"esbuild": true,
		"sharp": true
	},
	"dependencies": {
		"@astrojs/mdx": "^4.3.7",
		"@astrojs/react": "^4.4.0",
		"@astrojs/svelte": "^7.2.0",
		"@astrojs/vue": "^5.1.1",
		"@types/react": "^19.2.2",
		"@types/react-dom": "^19.2.1",
		"astro": "^5.14.3",
		"markdown-it": "^14.1.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"svelte": "^5.39.11",
		"typescript": "^5.9.3",
		"vue": "^3.5.22"
	},
	"devDependencies": {
		"@cherepanov.pavel/shareable-config": "^2.0.18",
		"@types/markdown-it": "^14.1.2",
		"astro-eslint-parser": "^3.2.0",
		"eslint": "^10.12.0",
		"eslint-plugin-astro": "^3.2.1",
		"typescript-eslint": "^8.71.1"
	}
}
